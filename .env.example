# RAVEL — Step 1 environment template
# Copy to .env and adjust as needed:  cp .env.example .env
# DEV credentials only — rotate everything before any production deploy.

# ─── PostgreSQL ───
# Superuser — used only for migrations and operational tasks.
POSTGRES_USER=ravel_admin
POSTGRES_PASSWORD=ravel_dev_password_change_me
POSTGRES_PORT=5432

# Application role — what every Python service connects with.
# Restricted privileges (no DELETE on DB-1.students; no UPDATE/DELETE on DB-2.interaction_logs).
POSTGRES_APP_USER=ravel_app
POSTGRES_APP_PASSWORD=ravel_app_dev_password_change_me

# ─── PgBouncer ───
PGBOUNCER_PORT=6432

# ─── Redis ───
REDIS_PASSWORD=ravel_redis_dev_change_me
REDIS_PORT=6379

# ─── Kafka ───
KAFKA_EXTERNAL_PORT=9094
# 22-char base64 KRaft cluster id. Regenerate with:
#   docker run --rm apache/kafka:3.8.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# ─── Qdrant ───
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── MinIO ───
MINIO_ROOT_USER=ravel_minio_admin
MINIO_ROOT_PASSWORD=ravel_minio_dev_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Embedding model (used from Step 4 onward) ───
# Dev:  paraphrase-multilingual-MiniLM-L12-v2  (384 dim)
# Prod: text-embedding-3-large                 (3072 dim)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ─── LLM provider (used from Step 4 onward) ───
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── API Gateway (Step 2a) ───
API_GATEWAY_PORT=8000
# Used for HMAC signing of JWT tokens. In production, generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=replace_me_with_a_long_random_string_at_least_48_chars_dev_only

# ─── Orchestrator (Step 3) ───
ORCHESTRATOR_GROUP_ID=orchestrator
# DB-1 connection — uses ravel_app role via PgBouncer (see Step 2b).
DB1_DSN=postgresql://ravel_app:ravel_app_dev_password_change_me@pgbouncer:6432/ravel_db1
# RAG request/response timeout. CLAUDE.md SLA: <1.5s text response total,
# of which ~3s is the upper bound for the RAG hop in dev.
RAG_REQUEST_TIMEOUT_SECONDS=3
# Mock LLM is used in Step 3-6; real LLM integration arrives in Step 7.
LLM_MOCK_MODE=true
# Bandit decision timeout (Actor SLA <50ms + Kafka hop buffer + cold-start consumer rebalance)
BANDIT_REQUEST_TIMEOUT_MS=500
# Reward formula constants (also used by Bandit Learner; mirrored here so
# Orchestrator can compute T_baseline before sending the reward log).
BANDIT_T_BASELINE_SECONDS=60

# ─── Bandit (Step 4) ───
BANDIT_GROUP_ID=bandit
# DB-2 connection — uses ravel_app role via PgBouncer.
DB2_DSN=postgresql://ravel_app:ravel_app_dev_password_change_me@pgbouncer:6432/ravel_db2
# MinIO — model weights persisted here for hot-swap between Actor and Learner.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=ravel_minio_admin
MINIO_SECRET_KEY=ravel_minio_dev_change_me
MINIO_BUCKET_WEIGHTS=bandit-weights
# LinTS hyperparameters
BANDIT_NUM_ACTIONS=3
BANDIT_CONTEXT_DIM=12
BANDIT_ALPHA=1.0
BANDIT_MINI_BATCH_SIZE=100
BANDIT_MINI_BATCH_TIMEOUT_SECONDS=60
ACTOR_INFERENCE_TIMEOUT_MS=50
# Reward formula weights (CLAUDE.md: α=0.6, β=0.2, γ=0.2)
REWARD_ALPHA=0.6
REWARD_BETA=0.2
REWARD_GAMMA=0.2

# ─── RAG (Step 5) ───
RAG_GROUP_ID=rag
ADMIN_API_PORT=8003
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_knowledge_base
SIMILARITY_THRESHOLD=0.45
SIMILARITY_THRESHOLD_RELAXED=0.30
TOP_K=8
RERANK_TOP_N=3
MINIO_BUCKET_CONTENT=rag-content

# ─── Manim Worker (Step 6) ───
MANIM_WORKER_GROUP_ID=manim_worker
MANIM_MAX_RETRIES=3
MANIM_RENDER_TIMEOUT_SECONDS=45
MANIM_VIDEO_QUALITY=720p
MANIM_TEMP_DIR=/tmp/manim_renders
MINIO_BUCKET_VIDEOS=ravel-videos
# AST whitelist — only these root packages can be imported by generated code.
SANDBOX_ALLOWED_IMPORTS=manim,numpy,math,random
SANDBOX_SYNTAX_CHECK_TIMEOUT_SECONDS=5
# Presigned URL expiration (seconds). Default 7 days.
VIDEO_URL_EXPIRATION_SECONDS=604800
# Orchestrator — extra timeout while waiting for Manim render to finish.
VIDEO_READY_TIMEOUT_SECONDS=90

# ─── Bandit test override (Step 6) ───
# Empty in production. Set to "video" / "manim_video" only for deterministic
# E2E tests of the video flow (ADR-017).
BANDIT_FORCE_DECISION=

# ─── LLM Gateway (Step 7) ───
# AES-256-GCM key for llm_configs.api_key encryption. 32 raw bytes = 64 hex chars.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Lose this key and every stored api_key is unrecoverable.
ENCRYPTION_KEY=replace_me_with_64_hex_chars_dev_only_64_hex_chars_dev_only_dev0

# ─── Frontend / Auth (Step 8) ───
# Seeded only on fresh postgres volume (init scripts).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ravel_admin_2025
# CORS allowlist (comma-separated) for the Vite dev server / nginx prod
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
FRONTEND_PORT=5173
